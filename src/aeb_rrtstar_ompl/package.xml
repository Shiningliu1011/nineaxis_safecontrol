<?xml version="1.0"?>
<package format="3">
  <name>aeb_rrtstar_ompl</name>
  <version>0.1.0</version>
  <description>AEB-RRT* adaptive bidirectional RRT* planner as a MoveIt2 OMPL plugin.</description>
  <maintainer email="maintainer@example.com">robot_safecontrol maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ompl</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>moveit_planners_ompl</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <moveit_core plugin="${prefix}/aeb_rrtstar_plugin_description.xml"/>
  </export>
</package>
