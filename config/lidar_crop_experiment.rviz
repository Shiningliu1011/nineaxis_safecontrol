Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 40
      Cell Size: 0.5
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: ROI Preview
      Topic:
        Value: /lidar_crop/preview
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Decay Time: 0
      Queue Size: 1
      Use Fixed Frame: true
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Use rainbow: true
      Alpha: 1.0
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: ROI Boundary
      Topic:
        Value: /lidar_crop/region
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Raw Reference
      Topic:
        Value: /livox/lidar
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Queue Size: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 100; 100; 100
      Alpha: 0.3
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: livox_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /lidar_crop/center
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Height: 950
  Width: 1400
