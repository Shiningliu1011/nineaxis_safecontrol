  "source_code": "from datetime import datetime\nfrom hashlib import sha256\nimport json\nfrom pathlib import Path\nimport runpy\nimport time\nfrom zoneinfo import ZoneInfo\n\nfrom robot_safecontrol_moveit.drempower_can import can_node_id, decode_feedback, decode_property_reply\nfrom robot_safecontrol_moveit.drempower_serial import DrEmpowerSerial, SERIAL_CAN_FRAME\n\n\nroot = Path(__file__).resolve().parents[2]\nfolder = Path(__file__).parent\nsdk_path = root / \"大然电机/大然电机所有资料/drempower-wiki-master/4-库函数/python/interface_enums.py\"\ndefinitions = runpy.run_path(str(sdk_path))\nfields = {\n    \"node_id\": (\"axis0.config.can_node_id\", 31001, \"u32\"),\n    \"hw_version\": (\"hw_version\", 5, \"u32\"), \"fw_version\": (\"fw_version\", 6, \"u32\"),\n    \"control_mode\": (\"axis0.controller.config.control_mode\", 32105, \"u32\"),\n    \"input_mode\": (\"axis0.controller.config.input_mode\", 32106, \"u32\"),\n    \"input_filter_bandwidth\": (\"axis0.controller.config.input_filter_bandwidth\", 32118, \"f32\"),\n    \"trajectory_done\": (\"axis0.controller.trajectory_done\", 32008, \"u32\"),\n}\nfor name, (canonical, address, kind) in fields.items():\n    vendor_kind = definitions[\"property_type\"][canonical]\n    if definitions[\"property_addresss\"][canonical] != address or (\n            \"f32\" if vendor_kind == \"f\" else vendor_kind) != kind:\n        raise ValueError(f\"{name} 与厂家字段地址或类型不符\")\nreport = {\n    \"evidence_kind\": \"post_power_cycle_readonly_operating_snapshot\",\n    \"started_at\": datetime.now(ZoneInfo(\"Asia/Shanghai\")).isoformat(),\n    \"status\": \"reading\", \"motion_commands_sent\": 0, \"parameter_writes_sent\": 0,\n    \"device_sample_time_known\": False, \"hardware_qualified\": False,\n    \"field_definitions\": fields, \"properties\": {}, \"observations\": [], \"feedback\": [],\n    \"sdk_sha256\": sha256(sdk_path.read_bytes()).hexdigest(),\n    \"source_code\": Path(__file__).read_text(encoding=\"utf-8\"),\n    \"source_sha256\": sha256(Path(__file__).read_bytes()).hexdigest(),\n}\noutput = folder / \"after-power-operating.json\"\nwith output.open(\"x\", encoding=\"utf-8\") as stream:\n    try:\n        with DrEmpowerSerial(\"/dev/serial/by-id/usb-Dr-Tech_DR-USB_CAN_87949380174B-if00\") as vendor:\n            try:\n                for node in range(1, 10):\n                    values = report[\"properties\"][f\"J{node}\"] = {}\n                    for name, (_, address, kind) in fields.items():\n                        requested = time.monotonic()\n                        value = vendor.read_property(node, address, kind)\n                        received = time.monotonic()\n                        raw = SERIAL_CAN_FRAME.parse(bytes.fromhex(vendor.frames[-1][\"raw_hex\"]))\n                        if decode_property_reply(raw.frame_id, raw.data, node_id=node,\n                                                 address=address, value_kind=kind) != value:\n                            raise ValueError(\"运行属性与原始回复不符\")\n                        values[name] = value\n                        report[\"observations\"].append({\"node_id\": node, \"name\": name, \"address\": address,\n                                                       \"kind\": kind, \"value\": value,\n                                                       \"request_s\": requested, \"received_s\": received})\n                    if values[\"node_id\"] != node:\n                        raise ValueError(\"运行配置节点身份不符\")\n                    requested = time.monotonic()\n                    vendor.get_state(node)\n                    raw = SERIAL_CAN_FRAME.parse(bytes.fromhex(vendor.frames[-1][\"raw_hex\"]))\n                    feedback = decode_feedback(raw.frame_id, raw.data)\n                    if feedback.axis_error or not feedback.traj_done:\n                        raise ValueError(\"上电运行快照存在故障或运动未完成\")\n                    report[\"feedback\"].append({\"node_id\": node, \"request_s\": requested,\n                                               \"received_s\": time.monotonic(), \"pos_deg\": feedback.pos_deg,\n                                               \"vel_rpm\": feedback.vel_rpm, \"axis_error\": feedback.axis_error,\n                                               \"traj_done\": feedback.traj_done})\n                for frame in vendor.frames:\n                    if frame[\"direction\"] == \"tx\" and can_node_id(SERIAL_CAN_FRAME.parse(\n                            bytes.fromhex(frame[\"raw_hex\"])).frame_id)[1] != 0x1e:\n                        raise ValueError(\"运行配置读取发送了属性读取之外的命令\")\n                report[\"status\"] = \"readonly_completed\"\n            finally:\n                report[\"frames\"] = vendor.frames\n    except BaseException as error:\n        report.update(status=\"readonly_failed\", reason=str(error))\n        raise\n    finally:\n        json.dump(report, stream, ensure_ascii=False, indent=2, allow_nan=False)\n        stream.write(\"\\n\")\nprint(json.dumps({\"status\": report[\"status\"], \"properties\": report[\"properties\"],\n                  \"sha256\": sha256(output.read_bytes()).hexdigest()}, ensure_ascii=False, indent=2))\n",
